	"private": true,
	"description": "Manage information and related services of VIEApps NGX CMS Portals",
	"engines": {
		"node": "^22.22.3 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"serve": "node tools/ionic-serve.mjs",
		"build": "node tools/angular-build.mjs",
		"build:development": "ng build --configuration development",
		"typecheck": "ngc --project tsconfig.app.json --noEmit",
		"verify:core": "node verification/run-core-contracts.mjs",
		"verify:session": "node verification/run-core-contracts.mjs session",
		"verify:transport": "node verification/run-core-contracts.mjs transport",
		"verify:forms": "node verification/run-core-contracts.mjs forms",
		"verify:completer": "node verification/run-core-contracts.mjs completer",
		"verify:ui:build": "ng build --configuration verification",
		"verify:ui:serve": "ng serve --configuration verification --host 127.0.0.1 --port 4311"
	},
	"dependencies": {
		"@angular/cdk": "22.2.5",
		"@angular/common": "22.2.5",
		"@angular/compiler": "22.2.5",
