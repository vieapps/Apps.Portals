		"@capacitor/inappbrowser": "4.1.0",
		"@capacitor/keyboard": "8.0.6",
		"@ionic/angular": "9.0.10",
		"@ionic/storage-angular": "4.0.0",
		"@ng-select/ng-select": "24.2.1",
		"@ngx-translate/core": "18.1.0",
		"@ngx-translate/http-loader": "18.1.0",
